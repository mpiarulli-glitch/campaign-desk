ze:16px; line-height:24px; color:#f1d4d5;\">No chatbot loop, no ticket queue that goes nowhere.</p>\n            </td>\n          </tr>\n\n          <!-- Body copy -->\n          <tr>\n            <td class=\"p-24\" style=\"padding:28px 36px 8px 36px; font-family:Arial,Helvetica,sans-serif; font-size:15px; line-height:23px; color:#1a1a1a;\">\n              Whether you've already placed an order or you're still working out what you need, the fastest way to get a straight answer is to call or email us directly. Here's what that actually gets you:\n            </td>\n          </tr>\n\n          <!-- Feature boxes 2x2 grid -->\n          <tr>\n            <td class=\"p-24\" style=\"padding:18px 28px 8px 28px;\">\n              <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                <tr>\n                  <td class=\"feature-col\" width=\"50%\" valign=\"top\" style=\"padding:0 8px 12px 0;\">\n                    <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                      <tr>\n                        <td style=\"background-color:#f5f5f5; padding:20px 18px;\">\n                          <p style=\"margin:0 0 6px 0; font-family:Arial,Helvetica,sans-serif; font-size:14px; font-weight:bold; color:#000000;\">Real technical support</p>\n                          <p style=\"margin:0; font-family:Arial,Helvetica,sans-serif; font-size:13px; line-height:20px; color:#3a3a3a;\">USA-based, and staffed by people who actually know the products.</p>\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                  <td class=\"feature-col\" width=\"50%\" valign=\"top\" style=\"padding:0 0 12px 8px;\">\n                    <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                      <tr>\n                        <td style=\"background-color:#f5f5f5; padding:20px 18px;\">\n                          <p style=\"margin:0 0 6px 0; font-family:Arial,Helvetica,sans-serif; font-size:14px; font-weight:bold; color:#000000;\">Dedicated Sales Specialist</p>\n                          <p style=\"margin:0; font-family:Arial,Helvetica,sans-serif; font-size:13px; line-height:20px; color:#3a3a3a;\">One point of contact for quotes and repeat orders, not a rotating queue.</p>\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n                <tr>\n                  <td class=\"feature-col\" width=\"50%\" valign=\"top\" style=\"padding:0 8px 0 0;\">\n                    <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                      <tr>\n                        <td style=\"background-color:#f5f5f5; padding:20px 18px;\">\n                          <p style=\"margin:0 0 6px 0; font-family:Arial,Helvetica,sans-serif; font-size:14px; font-weight:bold; color:#000000;\">Same-Day Ship</p>\n                          <p style=\"margin:0; font-family:Arial,Helvetica,sans-serif; font-size:13px; line-height:20px; color:#3a3a3a;\">In-stock items ship same day on orders placed before 1PM PST.</p>\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                  <td class=\"feature-col\" width=\"50%\" valign=\"top\" style=\"padding:0 0 0 8px;\">\n                    <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                      <tr>\n                        <td style=\"background-color:#f5f5f5; padding:20px 18px;\">\n                          <p style=\"margin:0 0 6px 0; font-family:Arial,Helvetica,sans-serif; font-size:14px; font-weight:bold; color:#000000;\">24-Hour Quote SLA</p>\n                          <p style=\"margin:0; font-family:Arial,Helvetica,sans-serif; font-size:13px; line-height:20px; color:#3a3a3a;\">Qualified commercial requests get a quote within one business day.</p>\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Body copy 2 -->\n          <tr>\n            <td class=\"p-24\" style=\"padding:22px 36px 8px 36px; font-family:Arial,Helvetica,sans-serif; font-size:15px; line-height:23px; color:#1a1a1a;\">\n              Save the number below. It goes to the same team that answers our email, not an outsourced call center reading from a script.\n            </td>\n          </tr>\n\n          <!-- CTA -->\n          <tr>\n            <td align=\"center\" class=\"p-24\" style=\"padding:22px 36px 22px 36px;\">\n              <!--[if mso]>\n              <v:roundrect xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:w=\"urn:schemas-microsoft-com:office:word\"\n                href=\"https://www.12voltpower.com/shop/\" style=\"height:48px;v-text-anchor:middle;width:220px;\" arcsize=\"8%\"\n                strokecolor=\"#b71f23\" fillcolor=\"#b71f23\">\n                <w:anchorlock/>\n                <center style=\"color:#ffffff;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;\">Shop with confidence</center>\n              </v:roundrect>\n              <![endif]-->\n              <!--[if !mso]><!-->\n              <a href=\"https://www.12voltpower.com/shop/\" style=\"background-color:#b71f23; border-radius:4px; color:#ffffff; display:inline-block; font-family:Arial,Helvetica,sans-serif; font-size:15px; font-weight:bold; line-height:48px; text-align:center; text-decoration:none; width:220px; -webkit-text-size-adjust:none;\">Shop with confidence</a>\n              <!--<![endif]-->\n            </td>\n          </tr>\n\n          <!-- Trust bar -->\n          <tr>\n            <td class=\"p-24\" style=\"padding:8px 36px 30px 36px;\">\n              <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color:#f5f5f5;\">\n                <tr>\n                  <td class=\"trust-col\" width=\"33%\" align=\"center\" valign=\"top\" style=\"padding:18px 10px; font-family:Arial,Helvetica,sans-serif; font-size:12px; line-height:17px; color:#3a3a3a;\">\n                    <strong style=\"color:#000000;\">Free shipping</strong><br>on orders over $100\n                  </td>\n                  <td class=\"trust-col\" width=\"34%\" align=\"center\" valign=\"top\" style=\"padding:18px 10px; font-family:Arial,Helvetica,sans-serif; font-size:12px; line-height:17px; color:#3a3a3a; border-left:1px solid #e2e2e2; border-right:1px solid #e2e2e2;\">\n                    <strong style=\"color:#000000;\">Same-day ship</strong><br>on in-stock orders by 1PM PST\n                  </td>\n                  <td class=\"trust-col\" width=\"33%\" align=\"center\" valign=\"top\" style=\"padding:18px 10px; font-family:Arial,Helvetica,sans-serif; font-size:12px; line-height:17px; color:#3a3a3a;\">\n                    <strong style=\"color:#000000;\">USA support</strong><br>real technical help\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Help line -->\n          <tr>\n            <td align=\"center\" class=\"p-24\" style=\"padding:0 36px 34px 36px; font-family:Arial,Helvetica,sans-serif; font-size:14px; line-height:21px; color:#3a3a3a;\">\n              Ready to talk? Call <a href=\"tel:+18009622611\" style=\"color:#b71f23; font-weight:bold; text-decoration:none;\">(800) 962-2611</a>, Mon to Fri, 8AM to 4PM PST.\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td align=\"center\" style=\"background-color:#000000; padding:28px 36px; font-family:Arial,Helvetica,sans-serif; font-size:12px; line-height:18px; color:#9a9a9a;\">\n              <p style=\"margin:0 0 8px 0; color:#ff