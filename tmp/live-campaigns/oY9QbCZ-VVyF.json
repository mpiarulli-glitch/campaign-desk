-height:23px; color:#1a1a1a;\">\n              All five categories are stocked with professional-grade brands, so you can source more of the build in one storefront without swapping suppliers halfway through.\n            </td>\n          </tr>\n\n          <!-- CTA -->\n          <tr>\n            <td align=\"center\" class=\"p-24\" style=\"padding:22px 36px 22px 36px;\">\n              <!--[if mso]>\n              <v:roundrect xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:w=\"urn:schemas-microsoft-com:office:word\"\n                href=\"https://www.12voltpower.com/shop/\" style=\"height:48px;v-text-anchor:middle;width:220px;\" arcsize=\"8%\"\n                strokecolor=\"#b71f23\" fillcolor=\"#b71f23\">\n                <w:anchorlock/>\n                <center style=\"color:#ffffff;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;\">Browse the full shop</center>\n              </v:roundrect>\n              <![endif]-->\n              <!--[if !mso]><!-->\n              <a href=\"https://www.12voltpower.com/shop/\" style=\"background-color:#b71f23; border-radius:4px; color:#ffffff; display:inline-block; font-family:Arial,Helvetica,sans-serif; font-size:15px; font-weight:bold; line-height:48px; text-align:center; text-decoration:none; width:220px; -webkit-text-size-adjust:none;\">Browse the full shop</a>\n              <!--<![endif]-->\n            </td>\n          </tr>\n\n          <!-- Help line -->\n          <tr>\n            <td align=\"center\" class=\"p-24\" style=\"padding:0 36px 34px 36px; font-family:Arial,Helvetica,sans-serif; font-size:14px; line-height:21px; color:#3a3a3a;\">\n              Not sure which category fits your build? Call <a href=\"tel:+18009622611\" style=\"color:#b71f23; font-weight:bold; text-decoration:none;\">(800) 962-2611</a>, Mon to Fri, 8AM to 4PM PST.\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td align=\"center\" style=\"background-color:#000000; padding:28px 36